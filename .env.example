# Base origin of the MITP resident portal (SysbuPro backend)
MITP_BASE_URL=https://paap.mitp.md

# SysbuPro application id (path segment: /p/api/<app>/...)
MITP_APP=resident

# Where the persisted browser session (cookies) is stored.
# Defaults to ~/.mitp-mcp/session.json
# MITP_SESSION_PATH=/Users/you/.mitp-mcp/session.json

# Read-only mode: when 1/true, all write actions are refused.
MITP_READ_ONLY=false

# Optional: inject a raw Cookie header instead of using the session file.
# Useful for CI or quick tests. Overrides the session file when set.
# MITP_COOKIE=JSESSIONID=xxxxxxxx; other=value
